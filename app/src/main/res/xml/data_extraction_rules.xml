<?xml version="1.0" encoding="utf-8"?>
<!-- A browser profile holds cookies, sign-ins and extension data. None of it is copied to
     cloud backups or to another device (Android 12+; older versions use allowBackup=false). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
