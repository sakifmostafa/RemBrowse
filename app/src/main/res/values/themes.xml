<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Launch window colours match the dark browser chrome (the default theme) so there is
         no flash before Compose draws. System bars are styled at runtime by enableEdgeToEdge. -->
    <style name="Theme.RemBrowse" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/rem_chrome</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
