<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The window in the light theme (values-night has the dark one). Its background is the
         chrome's colour, so there is no flash before Compose draws, and the platform's own pieces
         (text selection toolbar over a page, autofill) follow light or dark. Android 12+ starts
         the app in the mode chosen in Settings (UiModeManager.setApplicationNightMode); before
         that, these follow the device. System bars are styled at runtime by enableEdgeToEdge. -->
    <style name="Theme.RemBrowse" parent="@android:style/Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowBackground">@color/rem_chrome</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- The launch screen: the app icon on the chrome's colour, then Theme.RemBrowse -->
    <style name="Theme.RemBrowse.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/rem_chrome</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.RemBrowse</item>
    </style>
</resources>
