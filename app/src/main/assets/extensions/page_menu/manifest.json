{
  "manifest_version": 2,
  "name": "RemBrowse page menu",
  "description": "Part of RemBrowse: tells RemBrowse when a page leaves a right click to the browser, so RemBrowse can show the page's context menu.",
  "version": "1.0.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "page-menu@rembrowse"
    }
  },
  "permissions": ["nativeMessaging", "nativeMessagingFromContent", "geckoViewAddons"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["pageMenu.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start"
    }
  ]
}
