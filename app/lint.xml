<?xml version="1.0" encoding="utf-8"?>
<lint>
    <!-- Reported against ExoPlayer's notification helper bundled inside GeckoView, which
         RemBrowse never uses. RemBrowse asks for POST_NOTIFICATIONS itself when a site is allowed
         to show notifications. -->
    <issue id="NotificationPermission" severity="ignore" />
    <!-- The terminal emulator is Termux's code, kept as it is upstream (see com/termux/README.md). -->
    <issue id="DefaultLocale">
        <ignore path="src/main/java/com/termux/**" />
    </issue>
    <issue id="ObsoleteSdkInt">
        <ignore path="src/main/java/com/termux/**" />
    </issue>
    <!-- The AndroidX lint checks shipped with the newer Compose libraries (BOM 2026.06.01) are
         newer than the lint of Android Gradle Plugin 8.7. Compose UI's whole check registry
         (androidx.compose.ui.lint.UiIssueRegistry: UnnecessaryComposedModifier, the
         LocalContext* and Modifier* checks, MultipleAwaitPointerEventScopes and the rest) is
         skipped because it references APIs this lint lacks; that is the ObsoleteLintCustomCheck
         warning in every report. The checks below do load but crash
         (IncompatibleClassChangeError) and stop the whole run, so they are off. All of them come
         back with the build tools update. -->
    <issue id="FlowOperatorInvokedInComposition" severity="ignore" />
    <issue id="RememberInComposition" severity="ignore" />
    <issue id="FrequentlyChangingValue" severity="ignore" />
    <issue id="NullSafeMutableLiveData" severity="ignore" />
    <issue id="StateFlowValueCalledInComposition" severity="ignore" />
    <issue id="AutoboxingStateCreation" severity="ignore" />
    <issue id="CoroutineCreationDuringComposition" severity="ignore" />
    <issue id="UnrememberedMutableState" severity="ignore" />
</lint>
