# Gradle & build outputs
.gradle/
.kotlin/
app/build/
captures/
*.apk
*.aab
*.ap_
*.dex

# The repo-root build/ folder holds the published APKs (./gradlew publishApk).
# Everything else Gradle drops in there is scratch output.
/build/*
!/build/*.apk
!/build/VERSION.txt
!/build/update.json

# Local machine configuration
local.properties

# IDE files
.idea/
*.iml
.DS_Store

# Signing keys (keep keystore backed up securely outside public repos)
signing/*.jks
signing/*.keystore

# Temporary git worktrees made by Claude Code agents
.claude/worktrees/
